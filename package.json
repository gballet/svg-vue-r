    "diagram"
  ],
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/gballet/svg-vue-r/issues"
  },
  "homepage": "https://github.com/gballet/svg-vue-r#readme",
  "dependencies": {
    "font-awesome": "^4.7.0",
    "vue": "^2.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "babel-loader": "^10.0.0",
    "cross-env": "^3.0.0",
    "css-loader": "6",
    "expect": "^1.20.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-mocha": "^2.0.1",
    "karma-webpack": "^5.0.1",
    "mini-css-extract-plugin": "^2.9.4",
    "mocha": "^11.7.2",
    "vue-loader": "15",
    "vue-template-compiler": "^2.2.1",
    "webpack": "5",
