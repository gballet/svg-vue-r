{
  "name": "svg-vue-r",
  "version": "1.0.0",
  "author": "Guillaume Ballet",
  "private": true,
  "description": "A lightweight SVG graph editor built with Vue.js",
  "scripts": {
    "test": "cross-env BABEL_ENV=test karma start karma.conf.js --single-run",
    "dev": "cross-env NODE_ENV=development webpack-dev-server --hot",
    "build": "cross-env NODE_ENV=production webpack --progress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gballet/svg-vue-r.git"
  },
